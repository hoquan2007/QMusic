# ---------------------------------------------------------------------------
# QMusic — biến môi trường
# Sao chép file này thành .env.local rồi điền giá trị.
# KHÔNG commit .env.local hoặc bất kỳ secret nào.
# ---------------------------------------------------------------------------

# Audius (không bắt buộc — API đọc công khai vẫn hoạt động không cần key).
# Key đọc chỉ dùng phía server, không lộ ra trình duyệt.
# Lấy key miễn phí: https://api.audius.co/plans
AUDIUS_API_KEY=
AUDIUS_APP_NAME=QMusic

# Jamendo (tùy chọn — provider chỉ được bật khi biến này có giá trị).
# Đăng ký ứng dụng miễn phí: https://devportal.jamendo.com
# Không dùng testing client id trong production.
JAMENDO_CLIENT_ID=

# LRCLIB (tùy chọn — chỉ dùng để tăng rate limit).
# Đăng ký: https://lrclib.net/developers
LRCLIB_APP_ID=

# URL công khai của ứng dụng (dùng cho metadata và User-Agent).
# Để trống khi chạy local hoặc trên Vercel: ứng dụng tự dùng localhost/domain Vercel.
# Khi có custom domain, đặt ví dụ: https://qmusic.example.com
NEXT_PUBLIC_SITE_URL=
